{
  "name": "localllmapi-dev",
  "version": "2.0.0",
  "private": true,
  "description": "Dev-only tooling for LocalLLMAPI — jsdom powers the browser interaction tests. The app itself has no Node dependency.",
  "license": "MIT",
  "scripts": {
    "test": "node tools/test_frontend.js && node tools/test_keys.js",
    "test:static": "node tools/test_frontend.js",
    "test:interaction": "node tools/test_keys.js",
    "check": "python tools/check_frontend.py && python tools/check_i18n.py",
    "icon-preview": "node -e \"console.log('Otworz tools/icon-preview.html w przegladarce')\""
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
